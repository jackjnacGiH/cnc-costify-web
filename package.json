{
  "name": "cnc-costify-ai-v5",
  "version": "5.13.0",
  "description": "CNC Costify AI V5.13 - Fix: PDF/JPG blank screen (pin Babel JSX classic runtime against unpinned CDN drift)",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "benchmark-step": "node scripts/benchmark_step_volume.js --dir . --out benchmark_step_results.csv",
    "electron:start": "electron electron/main.js",
    "electron:dev": "set APP_URL=http://localhost:5000 && electron electron/main.js",
    "admin:start": "electron admin/main.js",
    "pack:win": "electron-builder --win --x64",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "admin:dist": "electron-builder --config build/admin-builder.yml -w --publish never",
    "backend:build": "pyinstaller -y CNC-Costify-AI.spec --distpath dist --workpath build/CNC-Costify-AI --clean",
    "backend:build:onefile": "node -e \"var p=process.env.OCC_PYTHON||'python';require('child_process').execSync(p+' -m PyInstaller -y CNC-Costify-AI.onefile.spec --distpath dist --workpath build/CNC-Costify-AI --clean',{stdio:'inherit'})\"",
    "build:v32": "npm run backend:build:onefile && npm run dist:win && npm run verify:v32 && npm run open:v32",
    "build:oneclick": "npm run build:v32",
    "verify:v32": "node -e \"const fs=require('fs');const p='release_v5/CNC Costify AI V5.13 Setup.exe';if(fs.existsSync(p)){console.log('Build OK: '+p);}else{console.error('Build failed: '+p+' not found');process.exit(1);}\"",
    "verify:release": "npm run verify:v32",
    "open:v32": "explorer release_v5",
    "open:release": "npm run open:v32",
    "postbuild:oneclick": "npm run verify:v32 && npm run open:v32",
    "build:v5": "npm run dist:win && npm run verify:v32 && npm run open:v32",
    "update-version": "node scripts/update-version.js"
  },
  "keywords": [
    "cnc",
    "cost",
    "calculator",
    "machining"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://www.cnccostify.cloud",
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cookie": "^1.1.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "opencascade.js": "^2.0.0-beta.b5ff984",
    "path": "^0.12.7",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^24.9.3",
    "nodemon": "^3.0.1"
  },
  "build": {
    "appId": "com.cnc.costify.ai.v5",
    "productName": "CNC Costify AI V5.13",
    "artifactName": "CNC Costify AI V5.13 Setup.exe",
    "directories": {
      "output": "release_v5"
    },
    "protocols": [
      {
        "name": "CNC Costify AI Protocol",
        "schemes": [
          "cnc-costify"
        ]
      }
    ],
    "files": [
      "electron/**",
      "lib/**",
      "server.js",
      "CNC_Costify_AI_V6.html",
      "PDF_JPG_Costify.html",
      "assets/**",
      "STLLoader.js",
      "step-converter.js",
      "ai_skills/**",
      "calibration_reference.json",
      "api_config.example.json",
      "node_modules/**",
      "!node_modules/nodemon/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/.cache/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.md",
      "!**/.git/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/spec/**",
      "!**/__tests__/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/opencascade.js/**",
      "node_modules/three/build/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app.ico",
      "extraResources": [
        {
          "from": "dist/CNC-Costify-AI.exe",
          "to": "CNC-Costify-AI.exe"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/app.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "dist/CNC-Costify-AI",
          "to": "CNC-Costify-AI"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons",
      "category": "Utility",
      "extraResources": [
        {
          "from": "dist/CNC-Costify-AI",
          "to": "CNC-Costify-AI"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CNC Costify AI V5.13",
      "perMachine": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  }
}
