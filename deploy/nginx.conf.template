# Nginx site config for CNC Costify Backend API
# Domain: api.cnccostify.cloud
# Reverse proxy → Node.js Express on 127.0.0.1:5000
#
# Place at: /etc/nginx/sites-available/cnc-costify
# Enable:   ln -s /etc/nginx/sites-available/cnc-costify /etc/nginx/sites-enabled/
# Test:     nginx -t && systemctl reload nginx
# SSL:      certbot --nginx -d api.cnccostify.cloud

# Rate-limit zone for /api/feedback/* — 30 req/min/IP (defense in depth)
limit_req_zone $binary_remote_addr zone=feedback_limit:10m rate=30r/m;

# HTTP → HTTPS redirect (certbot will auto-add this; this is the initial config)
server {
    listen 80;
    listen [::]:80;
    server_name api.cnccostify.cloud;

    # ACME challenge for Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Everything else → HTTPS (after SSL is set up; certbot rewrites this)
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS server (certbot will add ssl_certificate lines automatically)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.cnccostify.cloud;

    # SSL — these get filled by certbot:
    # ssl_certificate     /etc/letsencrypt/live/api.cnccostify.cloud/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/api.cnccostify.cloud/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Security headers
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Body size — for slip uploads in Phase 2 (max 10 MB)
    client_max_body_size 10M;

    # Logging
    access_log /var/log/nginx/cnc-costify-access.log;
    error_log  /var/log/nginx/cnc-costify-error.log;

    # Reverse proxy to Express (port 5000)
    location / {
        # Apply rate limit to feedback endpoints
        location ~ ^/api/feedback/ {
            limit_req zone=feedback_limit burst=10 nodelay;
            proxy_pass http://127.0.0.1:5000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 60s;
        }

        # Generic proxy
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }

    # Health check — bypass logging
    location = /health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
