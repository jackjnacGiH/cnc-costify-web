# Production environment for CNC Costify Backend (VPS)
# Copy to .env and fill in real values:
#   cp deploy/.env.example .env
#
# PM2 reads via ecosystem.config.cjs; or use: source .env

# Server
NODE_ENV=production
PORT=5000

# Skip Python Flask backend startup (VPS doesn't have OCC installed)
SKIP_FLASK=1

# Admin token for /api/feedback/list — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FEEDBACK_ADMIN_TOKEN=

# Email (Phase 2 — for sending license keys / verify emails)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=info@cnccostify.cloud
# SMTP_PASS=

# Database location override (optional)
# Default: $HOME/.cnc-costify/data/cnc.db on Linux
# CNC_DB_PATH=/var/lib/cnc-costify/data/cnc.db
